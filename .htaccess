<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect all requests to index.php except existing files/directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    # Remove invalid Permissions-Policy headers
    Header unset Permissions-Policy

    # Optional: set modern valid Permissions-Policy directives
    Header set Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), fullscreen=(self)"

    Header set Content-Security-Policy "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; connect-src 'self' http://172.16.126.253:5000 https:; font-src 'self' data: https:;"
</IfModule>
